      "allowed_fields": [
        "window_label",
        "percent_used",
        "reset_display",
        "model_scope",
        "usage_credits_enabled",
        "provider_version",
        "observed_at",
        "collected_at",
        "availability"
      ],
      "limits": {
        "deadline_seconds": 30,
        "max_concurrency_per_account": 1,
        "minimum_interval_seconds": 300,
        "automatic_retry_count": 0,
        "model_token_cost": 0,
        "provider_request_count": "unknown"
      }
    },
    {
      "capability_id": "local.process.correlation",
      "decision": "supported",
      "source_id": "linux.proc.process.v1",
      "operation_id": "linux.proc.claude-process.v1",
      "allowed_fields": [
        "executable_identity",
        "pid",
        "parent_pid",
        "same_uid",
        "kernel_state",
        "start_time_ticks",
        "user_cpu_ticks",
        "system_cpu_ticks",
        "resident_pages",
        "thread_count",
        "observed_at"
      ],
      "correlation_policy": "targeted-profile-probe-or-owner-confirmed-only"
