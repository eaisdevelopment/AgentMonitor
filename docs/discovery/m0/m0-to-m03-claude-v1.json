  "fail_closed_on": [
    "unverified_provider_version",
    "login_or_consent_prompt",
    "profile_write_possible",
    "unknown_output_field",
    "malformed_or_duplicate_window",
    "missing_provenance",
    "deadline",
    "weak_account_correlation"
