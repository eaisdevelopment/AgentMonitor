{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmonitor.invalid/contracts/m0-m3-handoff/1.0",
  "title": "AgentMonitor scoped M0-to-M3 handoff records",
  "oneOf": [
    {"$ref": "#/$defs/M0ToM03CapabilityMappingV1"},
    {"$ref": "#/$defs/M0ToM03OtelCapabilityMappingV1"},
    {"$ref": "#/$defs/M0ScopedEvidenceIndexV1"},
    {"$ref": "#/$defs/M0HandoffApprovalV1"},
    {"$ref": "#/$defs/M0HandoffAcceptanceV1"},
    {"$ref": "#/$defs/M0SchemaBundleV1"},
    {"$ref": "#/$defs/M03ContractBundleV1"}
  ],
  "$defs": {
    "Digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "OpaqueRef": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"},
    "ArtifactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/Digest"}
      }
    },
    "M0ToM03CapabilityMappingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "mapping_id", "mapping_version", "status", "scope", "schema_binding", "contract_binding", "capabilities", "normalized_outcomes", "required_provenance", "prohibited_inputs_and_outputs", "fail_closed_on"],
      "properties": {
        "record_type": {"const": "M0ToM03CapabilityMappingV1"},
        "schema_version": {"const": "1.0"},
        "mapping_id": {"const": "M0-M03-CLAUDE-001"},
        "mapping_version": {"const": "1.0.0"},
        "status": {"enum": ["structural_review_pending", "approved", "superseded"]},
        "scope": {"type": "object"},
        "schema_binding": {"type": "object"},
        "contract_binding": {"type": "object"},
        "capabilities": {"type": "array", "minItems": 3},
        "normalized_outcomes": {"type": "object"},
        "required_provenance": {"type": "array", "uniqueItems": true},
        "prohibited_inputs_and_outputs": {"type": "array", "uniqueItems": true},
        "fail_closed_on": {"type": "array", "uniqueItems": true}
      }
    },
    "M0ToM03OtelCapabilityMappingV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "mapping_id", "mapping_version", "status", "scope", "official_source", "source_id", "source_version", "parser_version", "capabilities", "transport_boundary", "agentmonitor_resource_attributes", "identity_policy", "targeted_profile_probe", "prohibited_inputs_and_outputs", "fail_closed_on"],
      "properties": {
        "record_type": {"const": "M0ToM03OtelCapabilityMappingV1"},
        "schema_version": {"const": "1.0"},
        "mapping_id": {"const": "M0-M03-CLAUDE-OTEL-001"},
        "mapping_version": {"const": "1.0.0"},
        "status": {"enum": ["structural_review_pending", "approved", "superseded"]},
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider_key", "product", "provider_version", "platform", "profile_ref"],
          "properties": {
            "provider_key": {"const": "claude"},
            "product": {"const": "Claude Code"},
            "provider_version": {"const": "2.1.278"},
            "platform": {"const": "Linux-x86_64"},
            "profile_ref": {"$ref": "#/$defs/OpaqueRef"}
          }
        },
        "official_source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url", "reviewed_at", "documented_protocol", "metric", "documented_attributes"],
          "properties": {
            "url": {"const": "https://code.claude.com/docs/en/monitoring-usage"},
            "reviewed_at": {"type": "string", "format": "date"},
            "documented_protocol": {"const": "OTLP HTTP/JSON metrics"},
            "metric": {"const": "claude_code.session.count"},
            "documented_attributes": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "source_id": {"const": "claude.otel.metrics.http-json.v1"},
        "source_version": {"const": "1.0.0"},
        "parser_version": {"const": "1.0.0"},
        "capabilities": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["local.session.discovery", "local.process.account_correlation"]}},
        "transport_boundary": {
          "type": "object",
          "additionalProperties": false,
          "required": ["address", "path", "authentication", "signals_enabled", "signals_disabled", "maximum_body_bytes", "request_timeout_seconds", "commit_ack_timeout_seconds", "raw_payload_retained"],
          "properties": {
            "address": {"const": "IPv4 loopback ephemeral port"},
            "path": {"const": "/v1/metrics"},
            "authentication": {"const": "one-launch in-memory bearer secret"},
            "signals_enabled": {"const": ["metrics"]},
            "signals_disabled": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"enum": ["logs", "traces"]}},
            "maximum_body_bytes": {"type": "integer", "minimum": 1},
            "request_timeout_seconds": {"type": "integer", "minimum": 1},
            "commit_ack_timeout_seconds": {"type": "integer", "minimum": 1},
            "raw_payload_retained": {"const": false}
          }
        },
        "agentmonitor_resource_attributes": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "pattern": "^agentmonitor\\.[a-z0-9_.]+$"}},
        "identity_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scheme", "scheme_version", "scope", "raw_provider_identity_retained", "owner_confirmation_required_before_automatic_match", "sole_account_fallback_prohibited", "conflict_outcome"],
          "properties": {
            "scheme": {"const": "claude.otel.account.sha256"},
            "scheme_version": {"const": 1},
            "scope": {"const": "provider_account"},
            "raw_provider_identity_retained": {"const": false},
            "owner_confirmation_required_before_automatic_match": {"const": true},
            "sole_account_fallback_prohibited": {"const": true},
            "conflict_outcome": {"const": "conflict"}
          }
        },
        "targeted_profile_probe": {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "evidence_ref", "repository_evidence", "repository_evidence_sha256", "verified_relationships", "raw_payload_retained", "provider_state_mutated", "provider_profile_mutated", "running_process_controlled"],
          "properties": {
            "status": {"enum": ["Passed", "Blocked", "Not Run"]},
            "evidence_ref": {"$ref": "#/$defs/OpaqueRef"},
            "repository_evidence": {"type": "string", "minLength": 1},
            "repository_evidence_sha256": {"$ref": "#/$defs/Digest"},
            "verified_relationships": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
            "raw_payload_retained": {"const": false},
            "provider_state_mutated": {"const": false},
            "provider_profile_mutated": {"const": false},
            "running_process_controlled": {"const": false}
          }
        },
        "prohibited_inputs_and_outputs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "fail_closed_on": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "M0ScopedEvidenceIndexV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "evidence_id", "scope_ref", "custody", "repository_content", "scenarios", "side_effect_reconciliations", "dynamic_values_retained", "raw_provider_output_retained", "prohibited_content_retained"],
      "properties": {
        "record_type": {"const": "M0ScopedEvidenceIndexV1"},
        "schema_version": {"const": "1.0"},
        "evidence_id": {"const": "M0-M3-CLAUDE-EVIDENCE-001"},
        "scope_ref": {"const": "M0-M03-CLAUDE-001"},
        "custody": {"const": "external-owner-controlled"},
        "repository_content": {"const": "sanitized-structural-status-and-opaque-references-only"},
        "scenarios": {"type": "array", "minItems": 1},
        "side_effect_reconciliations": {"type": "array", "minItems": 3},
        "dynamic_values_retained": {"const": false},
        "raw_provider_output_retained": {"const": false},
        "prohibited_content_retained": {"const": false}
      }
    },
    "M0HandoffApprovalV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "approval_id", "subject_id", "subject_sha256", "role", "decision", "reviewer_ref", "decision_date", "authority_ref"],
      "properties": {
        "record_type": {"const": "M0HandoffApprovalV1"},
        "schema_version": {"const": "1.0"},
        "approval_id": {"type": "string", "pattern": "^APR-M0-M3-[A-Z0-9-]+$"},
        "subject_id": {"const": "M0-M3-CLAUDE-HANDOFF-SUBJECT-001"},
        "subject_sha256": {"$ref": "#/$defs/Digest"},
        "role": {"enum": ["owner", "security_privacy", "test_integrity", "root_integration"]},
        "decision": {"enum": ["approved", "pending", "rejected"]},
        "reviewer_ref": {"oneOf": [{"$ref": "#/$defs/OpaqueRef"}, {"type": "null"}]},
        "decision_date": {"type": ["string", "null"], "format": "date"},
        "authority_ref": {"type": ["string", "null"]}
      }
    },
    "M0HandoffAcceptanceV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "acceptance_id", "status", "structural_prerequisite_authorized", "adapter_live_handoff_authorized", "subject", "subject_sha256", "approval_paths", "blockers"],
      "properties": {
        "record_type": {"const": "M0HandoffAcceptanceV1"},
        "schema_version": {"const": "1.0"},
        "acceptance_id": {"const": "M0-M3-CLAUDE-ACCEPTANCE-001"},
        "status": {"enum": ["structural_prerequisite_authorized", "accepted", "blocked", "rejected", "superseded"]},
        "structural_prerequisite_authorized": {"type": "boolean"},
        "adapter_live_handoff_authorized": {"type": "boolean"},
        "subject": {"type": "object"},
        "subject_sha256": {"$ref": "#/$defs/Digest"},
        "approval_paths": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true},
        "blockers": {"type": "array", "uniqueItems": true}
      }
    },
    "M0SchemaBundleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "bundle_id", "scope", "artifacts"],
      "properties": {
        "record_type": {"const": "M0SchemaBundleV1"},
        "schema_version": {"const": "1.0"},
        "bundle_id": {"const": "M0-M3-SCHEMA-BUNDLE-001"},
        "scope": {"const": "g1-controls-and-scoped-m3-handoff"},
        "artifacts": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/ArtifactBinding"}}
      }
    },
    "M03ContractBundleV1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "bundle_id", "contract_id", "contract_version", "status", "normative_artifacts", "schema_artifact_status", "schema_artifact", "blocking_reason"],
      "properties": {
        "record_type": {"const": "M03ContractBundleV1"},
        "schema_version": {"const": "1.0"},
        "bundle_id": {"const": "M3-CTR-PROV-002-BUNDLE-001"},
        "contract_id": {"const": "CTR-PROV-002"},
        "contract_version": {"const": "1.0.0"},
        "status": {"enum": ["current", "blocked", "superseded"]},
        "normative_artifacts": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/ArtifactBinding"}},
        "schema_artifact_status": {"enum": ["current", "missing"]},
        "schema_artifact": {"oneOf": [{"$ref": "#/$defs/ArtifactBinding"}, {"type": "null"}]},
        "blocking_reason": {"type": ["string", "null"]}
      }
    }
  }
}
