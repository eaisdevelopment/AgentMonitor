{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentmonitor.invalid/contracts/m0-g1-record/0.3.0-draft",
  "title": "AgentMonitor M0 G1 record",
  "description": "Minimal safety-control records for Milestone 0 discovery.",
  "oneOf": [
    {"$ref": "#/$defs/ApprovalRecordV1"},
    {"$ref": "#/$defs/CustodyDecisionV1"},
    {"$ref": "#/$defs/E1ScannerAdmissionV1"},
    {"$ref": "#/$defs/IncidentRecordV1"},
    {"$ref": "#/$defs/OperationPacketV1"},
    {"$ref": "#/$defs/RunResultV1"},
    {"$ref": "#/$defs/ScenarioLedgerV1"}
  ],
  "$defs": {
    "ApprovalRecordV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "approval_id",
        "subject_id",
        "subject_sha256",
        "role",
        "decision",
        "reviewer_ref",
        "decided_at_utc"
      ],
      "properties": {
        "record_type": {"const": "ApprovalRecordV1"},
        "schema_version": {"const": "1.0"},
        "approval_id": {"type": "string", "pattern": "^APR-[A-Z0-9-]+$"},
        "subject_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "subject_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "role": {
          "enum": [
            "owner",
            "security_privacy",
            "test_integrity",
            "provider_system",
            "root_integration"
          ]
        },
        "decision": {"enum": ["approved", "rejected"]},
        "reviewer_ref": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"},
        "decided_at_utc": {"type": "string", "format": "date-time"},
        "expires_at_utc": {
          "type": ["string", "null"],
          "format": "date-time"
        }
      }
    },
    "CustodyDecisionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "decision_id",
        "external_root_ref",
        "owner_selected",
        "repository_storage_prohibited",
        "permissions_verified",
        "sync_backup_disposition",
        "retention_until_utc",
        "approvals"
      ],
      "properties": {
        "record_type": {"const": "CustodyDecisionV1"},
        "schema_version": {"const": "1.0"},
        "decision_id": {"type": "string", "pattern": "^CUST-[A-Z0-9-]+$"},
        "external_root_ref": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"},
        "owner_selected": {"const": true},
        "repository_storage_prohibited": {"const": true},
        "permissions_verified": {"type": "boolean"},
        "sync_backup_disposition": {
          "enum": [
            "excluded",
            "owner_accepted_encrypted",
            "owner_accepted_synced",
            "blocked"
          ]
        },
        "retention_until_utc": {"type": "string", "format": "date-time"},
        "approvals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ApprovalRecordV1"}
        }
      }
    },
    "E1ScannerAdmissionV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "admission_id",
        "scanner_name",
        "scanner_version",
        "binary_sha256",
        "configuration_sha256",
        "license",
        "dependency_review_ref",
        "telemetry_disabled",
        "network_required",
        "output_policy",
        "real_verification_status",
        "decision",
        "approvals"
      ],
      "properties": {
        "record_type": {"const": "E1ScannerAdmissionV1"},
        "schema_version": {"const": "1.0"},
        "admission_id": {"type": "string", "pattern": "^E1-[A-Z0-9-]+$"},
        "scanner_name": {"type": "string", "minLength": 1, "maxLength": 80},
        "scanner_version": {"type": "string", "minLength": 1, "maxLength": 40},
        "binary_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "configuration_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "license": {"type": "string", "minLength": 1, "maxLength": 80},
        "dependency_review_ref": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"},
        "telemetry_disabled": {"const": true},
        "network_required": {"const": false},
        "output_policy": {"const": "discard_raw_output"},
        "real_verification_status": {
          "enum": ["Passed", "Failed", "Blocked", "Not Run"]
        },
        "decision": {"enum": ["approved", "rejected", "blocked"]},
        "evidence_ref": {
          "type": ["string", "null"],
          "pattern": "^REF-[A-Z0-9-]+$"
        },
        "approvals": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ApprovalRecordV1"}
        }
      }
    },
    "IncidentRecordV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "incident_id",
        "scenario_id",
        "operation_id",
        "detected_at_utc",
        "category",
        "operation_stopped",
        "provider_state_preserved",
        "running_agents_preserved",
        "owner_notified",
        "summary_code"
      ],
      "properties": {
        "record_type": {"const": "IncidentRecordV1"},
        "schema_version": {"const": "1.0"},
        "incident_id": {"type": "string", "pattern": "^INC-[A-Z0-9-]+$"},
        "scenario_id": {"type": "string", "pattern": "^M0-[A-Z0-9-]+-[0-9]{3}$"},
        "operation_id": {"type": "string", "pattern": "^OP-[A-Z0-9-]+$"},
        "detected_at_utc": {"type": "string", "format": "date-time"},
        "category": {
          "enum": [
            "authentication",
            "mutation",
            "network",
            "billing",
            "prohibited_data",
            "path_or_permission",
            "process_effect",
            "scope_mismatch",
            "unknown"
          ]
        },
        "operation_stopped": {"const": true},
        "provider_state_preserved": {"type": "boolean"},
        "running_agents_preserved": {"type": "boolean"},
        "owner_notified": {"type": "boolean"},
        "quarantine_ref": {
          "type": ["string", "null"],
          "pattern": "^REF-[A-Z0-9-]+$"
        },
        "summary_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}
      }
    },
    "OperationPacketV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "packet_id",
        "operation_id",
        "scenario_id",
        "custody_decision_id",
        "finalized_at_utc",
        "expires_at_utc",
        "operation",
        "targets",
        "assertions",
        "side_effect_budget",
        "stop_conditions",
        "approvals"
      ],
      "properties": {
        "record_type": {"const": "OperationPacketV1"},
        "schema_version": {"const": "1.0"},
        "packet_id": {"type": "string", "pattern": "^PKT-[A-Z0-9-]+$"},
        "operation_id": {"type": "string", "pattern": "^OP-[A-Z0-9-]+$"},
        "scenario_id": {"type": "string", "pattern": "^M0-[A-Z0-9-]+-[0-9]{3}$"},
        "custody_decision_id": {"type": "string", "pattern": "^CUST-[A-Z0-9-]+$"},
        "finalized_at_utc": {"type": "string", "format": "date-time"},
        "expires_at_utc": {"type": "string", "format": "date-time"},
        "operation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "boundary",
            "executable_ref",
            "arguments",
            "timeout_seconds",
            "network_policy"
          ],
          "properties": {
            "boundary": {
              "enum": [
                "documentation",
                "filesystem",
                "process",
                "provider_cli",
                "https_api",
                "os_api"
              ]
            },
            "executable_ref": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"},
            "arguments": {
              "type": "array",
              "maxItems": 32,
              "items": {"type": "string", "maxLength": 512}
            },
            "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 300},
            "network_policy": {"enum": ["denied", "exact_allowlist"]},
            "allowed_hosts": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 253}
            }
          }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"}
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertion_id", "kind", "expected"],
            "properties": {
              "assertion_id": {"type": "string", "pattern": "^AST-[A-Z0-9-]+$"},
              "kind": {
                "enum": [
                  "presence",
                  "absence",
                  "equality",
                  "range",
                  "containment",
                  "side_effect"
                ]
              },
              "expected": {"type": "string", "minLength": 1, "maxLength": 256}
            }
          }
        },
        "side_effect_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network_requests",
            "provider_requests",
            "cost_minor_units",
            "writes_allowed",
            "profile_changes_allowed",
            "process_signals_allowed"
          ],
          "properties": {
            "network_requests": {"type": "integer", "minimum": 0, "maximum": 20},
            "provider_requests": {"type": "integer", "minimum": 0, "maximum": 20},
            "cost_minor_units": {"const": 0},
            "writes_allowed": {"const": false},
            "profile_changes_allowed": {"const": false},
            "process_signals_allowed": {"const": false}
          }
        },
        "stop_conditions": {
          "type": "array",
          "minItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "AUTHENTICATION_PROMPT",
              "MUTATION_OR_UPDATE_PROMPT",
              "UNEXPECTED_NETWORK",
              "UNEXPECTED_COST_OR_RATE_LIMIT",
              "PROHIBITED_DATA",
              "PATH_OR_PERMISSION_MISMATCH",
              "RUNNING_PROCESS_EFFECT",
              "SCOPE_OR_VERSION_MISMATCH",
              "UNKNOWN_BEHAVIOR"
            ]
          }
        },
        "approvals": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ApprovalRecordV1"}
        }
      }
    },
    "RunResultV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "run_id",
        "packet_id",
        "operation_id",
        "scenario_id",
        "started_at_utc",
        "ended_at_utc",
        "termination",
        "assertion_results",
        "actual_side_effects",
        "prohibited_data_observed",
        "evidence_refs",
        "incident_id",
        "status"
      ],
      "properties": {
        "record_type": {"const": "RunResultV1"},
        "schema_version": {"const": "1.0"},
        "run_id": {"type": "string", "pattern": "^RUN-[A-Z0-9-]+$"},
        "packet_id": {"type": "string", "pattern": "^PKT-[A-Z0-9-]+$"},
        "operation_id": {"type": "string", "pattern": "^OP-[A-Z0-9-]+$"},
        "scenario_id": {"type": "string", "pattern": "^M0-[A-Z0-9-]+-[0-9]{3}$"},
        "started_at_utc": {"type": "string", "format": "date-time"},
        "ended_at_utc": {"type": "string", "format": "date-time"},
        "termination": {
          "enum": ["completed", "not_started", "timed_out", "cancelled", "failed"]
        },
        "assertion_results": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["assertion_id", "outcome", "evidence_ref"],
            "properties": {
              "assertion_id": {"type": "string", "pattern": "^AST-[A-Z0-9-]+$"},
              "outcome": {"enum": ["satisfied", "violated", "unknown"]},
              "evidence_ref": {
                "type": ["string", "null"],
                "pattern": "^REF-[A-Z0-9-]+$"
              }
            }
          }
        },
        "actual_side_effects": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "network_requests",
            "provider_requests",
            "cost_minor_units",
            "writes_observed",
            "profile_changes_observed",
            "process_signals_observed"
          ],
          "properties": {
            "network_requests": {"type": ["integer", "null"], "minimum": 0},
            "provider_requests": {"type": ["integer", "null"], "minimum": 0},
            "cost_minor_units": {"type": ["integer", "null"], "minimum": 0},
            "writes_observed": {"type": ["boolean", "null"]},
            "profile_changes_observed": {"type": ["boolean", "null"]},
            "process_signals_observed": {"type": ["boolean", "null"]}
          }
        },
        "prohibited_data_observed": {"type": ["boolean", "null"]},
        "evidence_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"}
        },
        "incident_id": {
          "type": ["string", "null"],
          "pattern": "^INC-[A-Z0-9-]+$"
        },
        "status": {"enum": ["Passed", "Failed", "Blocked"]}
      }
    },
    "ScenarioLedgerV1": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_type",
        "schema_version",
        "ledger_id",
        "plan_id",
        "plan_sha256",
        "generated_at_utc",
        "entries"
      ],
      "properties": {
        "record_type": {"const": "ScenarioLedgerV1"},
        "schema_version": {"const": "1.0"},
        "ledger_id": {"type": "string", "pattern": "^LEDGER-[A-Z0-9-]+$"},
        "plan_id": {"const": "PLAN-M0-DISCOVERY"},
        "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "generated_at_utc": {"type": "string", "format": "date-time"},
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/ScenarioLedgerV1/$defs/entry"}
        }
      },
      "$defs": {
        "entry": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scenario_id",
            "status",
            "reason_code",
            "packet_id",
            "run_id",
            "evidence_refs"
          ],
          "properties": {
            "scenario_id": {"type": "string", "pattern": "^M0-[A-Z0-9-]+-[0-9]{3}$"},
            "status": {"enum": ["Passed", "Failed", "Blocked", "Not Run"]},
            "reason_code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"},
            "packet_id": {
              "type": ["string", "null"],
              "pattern": "^PKT-[A-Z0-9-]+$"
            },
            "run_id": {
              "type": ["string", "null"],
              "pattern": "^RUN-[A-Z0-9-]+$"
            },
            "evidence_refs": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^REF-[A-Z0-9-]+$"}
            }
          }
        }
      }
    }
  }
}
